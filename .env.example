# Optional settings for SoF Tracker. Copy this file to ".env" (next to server.js) and remove the # in front of a line
# to use it. Without a .env file the tracker uses the defaults shown here. Real environment variables win over .env.
# Nothing secret goes in here: tokens for ntfy, Telegram and Discord are entered in the dashboard and kept in data\.

# The game's Client folder (the one with YGOnline.exe and the log files). Normally found by the installer.
# SOF_CLIENT_DIR=C:\NetGame\ScionsOfFate\Client

# The game launcher, for the "Play" and "2nd client" buttons (default: launcher.exe in the game folder).
# SOF_LAUNCHER=C:\NetGame\ScionsOfFate\launcher.exe

# Where the tracker keeps its data (default: the data folder next to server.js).
# SOF_DATA_DIR=D:\SoF Tracker data

# Phone view: 0.0.0.0 makes the dashboard reachable from your home network (with an access key, see the
# dashboard). Default 127.0.0.1 = this PC only. start-phone.bat sets this for you.
# SOF_HOST=127.0.0.1

# The time zone the game server announces its times in.
# SOF_SERVER_TZ=America/Los_Angeles

# Port of the dashboard. The tray icon, overlay and installer expect 7777, so only change it for testing.
# PORT=7777

# ---- for testing releases only (see docs/RELEASING.md) ----
# Read the update file from another address (it must still be signed with your key).
# SOF_UPDATE_URL=https://raw.githubusercontent.com/YOUR-NAME/sof-tracker/test/updates/update.json
# No website calls at all (the tests use this).
# SOF_OFFLINE=1
